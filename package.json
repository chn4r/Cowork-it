{
  "name": "cowork-it",
  "private": true,
  "version": "3.5.0",
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "lint": "node scripts/check.js",
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke.spec.js",
    "test:ui": "playwright test --ui",
    "check": "npm run lint && npm run test:smoke",
    "deploy:check": "npm run check",
    "supabase:link": "supabase link",
    "supabase:push": "supabase db push",
    "supabase:types": "supabase gen types typescript --local > src/database.types.ts",
    "publish-ui": "node scripts/publish-server.js",
    "publish:dry": "node scripts/publish-cli.js --dry-run",
    "publish": "node scripts/publish-cli.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
